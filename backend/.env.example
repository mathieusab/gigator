# Backend
PORT=3000

# Frontend origin for OAuth callback redirect
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (service role key is REQUIRED for storing Gmail refresh tokens)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail OAuth Client (Google Cloud OAuth 2.0 Client ID)
GMAIL_PROXY_CLIENT_ID=
GMAIL_PROXY_CLIENT_SECRET=

# OAuth redirect URI must match the one configured in Google Cloud console
# For local dev, this should point to the backend callback route.
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/gmail/oauth/callback

# Strong secrets
# 32 bytes, base64 (example): `openssl rand -base64 32`
GMAIL_TOKEN_ENCRYPTION_KEY=
# Used to sign the OAuth "state" parameter (example): `openssl rand -hex 32`
GMAIL_OAUTH_STATE_SECRET=
