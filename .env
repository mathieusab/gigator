# Backend server
HOST=127.0.0.1
PORT=3000

# App session/JWT
# Generate a strong random secret (example): `openssl rand -hex 32`
APP_JWT_SECRET=
APP_SESSION_COOKIE_NAME=app_session

# After successful Google login, backend redirects the browser here
# (frontend base URL)
APP_OAUTH_SUCCESS_REDIRECT_URI=http://localhost:5173/

# Google OAuth (App login)
# Create OAuth 2.0 Client ID in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI configured in Google Cloud
GOOGLE_APP_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Database (required for login: profiles upsert + allowlist lookup)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gigator

# Allowlist (optional): comma-separated emails.
# If unset, the DB table app_email_allowlist is used instead.
APP_EMAIL_ALLOWLIST=you@example.com
